# Cupons ITD — modelo de configuração.
#
#   cp .env.example .env
#
# NUNCA comite o .env. Gere os segredos com:
#   openssl rand -base64 48        # JWT_SECRET
#   openssl rand -base64 24        # POSTGRES_PASSWORD

# --- Domínio e ambiente -------------------------------------------------
# Em produção: AMBIENTE=producao faz o cookie de sessão exigir HTTPS.
AMBIENTE=desenvolvimento
DOMINIO=cupom.fbtax.cloud
DOMINIO_URL=https://cupom.fbtax.cloud
EMAIL_ACME=claudiosousadebezerra@gmail.com

# Em desenvolvimento o frontend roda em outra porta, então precisa de CORS.
# Em produção o compose de produção já usa DOMINIO_URL e isto é ignorado.
CORS_ORIGENS=http://localhost:5173
VITE_API_URL=http://localhost:8080

# --- Banco ---------------------------------------------------------------
POSTGRES_DB=cupons
POSTGRES_USER=cupons
POSTGRES_PASSWORD=troque-esta-senha

# --- Sessão e primeiro acesso -------------------------------------------
# JWT_SECRET precisa de no mínimo 32 caracteres; a API recusa subir com menos.
JWT_SECRET=troque-por-uma-chave-aleatoria-de-48-bytes-no-minimo
SESSAO_HORAS=12

# Criados apenas se a tabela de usuários estiver vazia.
ADMIN_EMAIL=claudiosousadebezerra@gmail.com
ADMIN_SENHA=troque-esta-senha-tambem

# --- Leitura dos cupons via Claude (visão) ------------------------------
# Sem a chave o sistema sobe normalmente, mas a importação por PDF fica
# indisponível. A chave existe SÓ no servidor: nunca vai ao frontend.
ANTHROPIC_API_KEY=

# Modelo da leitura normal e do botão "reprocessar com modelo mais forte".
CLAUDE_MODEL=claude-opus-5
CLAUDE_MODEL_FORTE=claude-fable-5

# Esforço de raciocínio: low, medium, high, xhigh, max. Cupom apagado
# melhora com esforço maior, e cada degrau custa mais.
CLAUDE_ESFORCO=high
CLAUDE_TIMEOUT_S=180

# Páginas lidas em paralelo. Acima de 3 o risco de 429 na API cresce.
LEITURA_CONCORRENCIA=3

# Lado maior da imagem enviada à API. 1568 é o ponto em que a própria API
# pararia de ganhar resolução; aumente se os cupons estiverem muito apagados
# (custa mais), ou use 0 para enviar sem redimensionar.
LEITURA_LADO_MAX=1568

# Teto de leituras por dia, para controle de custo. 0 desliga o limite.
LIMITE_LEITURAS_DIA=200

# --- Upload e PDF --------------------------------------------------------
UPLOAD_MAX_MB=50
# DPI da rasterização de fallback (PDFs sem JPEG embutido por página).
PDF_DPI=300

# --- Portas locais (só no compose de desenvolvimento) -------------------
API_PORTA=8080
FRONTEND_PORTA=5173

# --- Backup --------------------------------------------------------------
BACKUP_HORA=03
BACKUP_RETENCAO_DIAS=14
